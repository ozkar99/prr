{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Review Tool",
  "version": "0.2.0",
  "identifier": "com.ozkar99.review-tool",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../out/renderer",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web && npm run bundle:resources"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../node_modules/pyright/": "pyright/",
      "resources/bash-language-server/": "bash-language-server/"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
